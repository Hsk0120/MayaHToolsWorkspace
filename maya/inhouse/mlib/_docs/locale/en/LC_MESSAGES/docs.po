msgstr "Returns component-wise subtraction with respect to MVector class."

msgid ":py:obj:`__truediv__ <mlib.maths.vector.Vector.__truediv__>`\\ \\(other\\)"
msgstr ":py:obj:`__truediv__ <mlib.maths.vector.Vector.__truediv__>`\\ \\(other\\)"

