msgstr ""

msgid "各要素のcopyWeightsToを同じ引数で呼び、コレクション自身を返す。"
msgstr "Call each item's copyWeightsTo with the same arguments and return this collection."

msgid ":py:obj:`deforms <mlib.nodes.skinCluster.SkinClusters.deforms>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のdeformsを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's deforms with the same arguments and return results in collection order."

msgid ":py:obj:`getBindPose <mlib.nodes.skinCluster.SkinClusters.getBindPose>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のgetBindPoseを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's getBindPose with the same arguments and return results in collection order."

msgid ":py:obj:`getInfluences <mlib.nodes.skinCluster.SkinClusters.getInfluences>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のgetInfluencesを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's getInfluences with the same arguments and return results in collection order."

msgid ":py:obj:`getMaxInfluences <mlib.nodes.skinCluster.SkinClusters.getMaxInfluences>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のgetMaxInfluencesを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's getMaxInfluences with the same arguments and return results in collection order."

msgid ":py:obj:`getUnusedInfluences <mlib.nodes.skinCluster.SkinClusters.getUnusedInfluences>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のgetUnusedInfluencesを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's getUnusedInfluences with the same arguments and return results in collection order."

msgid ":py:obj:`getWeights <mlib.nodes.skinCluster.SkinClusters.getWeights>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のgetWeightsを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's getWeights with the same arguments and return results in collection order."

msgid ":py:obj:`hasInfluence <mlib.nodes.skinCluster.SkinClusters.hasInfluence>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のhasInfluenceを同じ引数で呼び、保持順の戻り値リストを返す。"
msgstr "Call each item's hasInfluence with the same arguments and return results in collection order."

msgid ":py:obj:`normalizeWeights <mlib.nodes.skinCluster.SkinClusters.normalizeWeights>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のnormalizeWeightsを同じ引数で呼び、コレクション自身を返す。"
msgstr "Call each item's normalizeWeights with the same arguments and return this collection."

msgid ":py:obj:`redistributeWeights <mlib.nodes.skinCluster.SkinClusters.redistributeWeights>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ""

msgid "各要素のredistributeWeightsを同じ引数で呼び、コレクション自身を返す。"
msgstr "Call each item's redistributeWeights with the same arguments and return this collection."

msgid ":py:obj:`removeInfluence <mlib.nodes.skinCluster.SkinClusters.removeInfluence>`\\ \\(\\*args\\, \\*\\*kwargs\\)"
msgstr ":py:obj:`removeInfluence <mlib.nodes.skinCluster.SkinClusters.removeInfluence>`\\ \\(\\*args\\, \\*\\*kwargs\\)"

msgid ":py:obj:`removeInfluences <mlib.nodes.skinCluster.SkinClusters.removeInfluences>`\\ \\(joints\\[\\, transfer\\_to\\_parent\\, force\\, f\\]\\)"
msgstr ""

msgid "保持するskinClusterだけから、指定jointのinfluence登録を外す。"
