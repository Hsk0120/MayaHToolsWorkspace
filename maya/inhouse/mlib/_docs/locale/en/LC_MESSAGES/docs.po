msgstr ":py:obj:`fn <mlib.nodes.skinCluster.SkinCluster.fn>`\\"

msgid ":py:obj:`mesh <mlib.nodes.skinCluster.SkinCluster.mesh>`\\"
msgstr ":py:obj:`mesh <mlib.nodes.skinCluster.SkinCluster.mesh>`\\"

