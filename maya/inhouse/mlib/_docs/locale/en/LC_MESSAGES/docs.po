msgstr ":py:obj:`getPosition <mlib.components.uv.UVs.getPosition>`\\ \\(\\)"

msgid "現在のUVセットのU/V座標を、保持番号の順に取得する。"
msgstr "Read U/V coordinates from the current UV set in stored-index order."

msgid ":py:obj:`getU <mlib.components.uv.UVs.getU>`\\ \\(\\)"
msgstr ":py:obj:`getU <mlib.components.uv.UVs.getU>`\\ \\(\\)"

