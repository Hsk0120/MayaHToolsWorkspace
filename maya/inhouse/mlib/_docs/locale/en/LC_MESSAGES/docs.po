msgstr "Scale all keys around their original values. Tangent handling follows Maya's scaleKey behavior."

msgid ":py:obj:`setInfinity <mlib.nodes.animCurve.AnimCurve.setInfinity>`\\ \\(\\*\\[\\, pre\\, post\\, fast\\]\\)"
msgstr ":py:obj:`setInfinity <mlib.nodes.animCurve.AnimCurve.setInfinity>`\\ \\(\\*\\[\\, pre\\, post\\, fast\\]\\)"

