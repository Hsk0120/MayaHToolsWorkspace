msgstr ":py:obj:`exists <mlib.common.drivenKey.DrivenKey.exists>`\\ \\(\\)"

msgid "対応するカーブ接続が存在するか。キーが空でもTrue。"
msgstr "Does a corresponding curve connection exist. Returns True even if the key is empty."

msgid ":py:obj:`find <mlib.common.drivenKey.DrivenKey.find>`\\ \\(driven\\)"
msgstr ":py:obj:`find <mlib.common.drivenKey.DrivenKey.find>`\\ \\(driven\\)"

msgid "駆動先に接続された関係を取得する。シーンは変更しない。"
msgstr "Get the connected relationships to the driven object. Do not modify the scene."

msgid ":py:obj:`getCurves <mlib.common.drivenKey.DrivenKey.getCurves>`\\ \\(\\)"
msgstr ":py:obj:`getCurves <mlib.common.drivenKey.DrivenKey.getCurves>`\\ \\(\\)"

