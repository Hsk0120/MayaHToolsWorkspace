msgstr "Retrieve jointOrient as an independent EulerRotate in XYZ order and radians."

msgid ":py:obj:`getParentJointName <mlib.nodes.joint.Joint.getParentJointName>`\\ \\(\\)"
msgstr ":py:obj:`getParentJointName <mlib.nodes.joint.Joint.getParentJointName>`\\ \\(\\)"

