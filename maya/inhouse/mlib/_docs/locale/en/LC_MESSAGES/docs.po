msgstr ":py:obj:`_UNKNOWN_TOTAL <mlib.common.progress._UNKNOWN_TOTAL>`\\"

msgid ":py:obj:`_ProgressLine <mlib.common.progress._ProgressLine>`\\"
msgstr ":py:obj:`_ProgressLine <mlib.common.progress._ProgressLine>`\\"

