msgstr "class mlib.nodes.camera.Camera"

msgid "ベースクラス: :py:obj:`mlib.nodes.shape.Shape`"
msgstr "Base class: :py:obj:`mlib.nodes.shape.Shape`"

msgid "Maya camera shape ノードのラッパー。"
msgstr "Wrapper for Maya camera shape node."

msgid ":py:obj:`cameraFn <mlib.nodes.camera.Camera.cameraFn>`\\ \\(\\)"
msgstr ":py:obj:`cameraFn <mlib.nodes.camera.Camera.cameraFn>`\\ \\(\\)"

