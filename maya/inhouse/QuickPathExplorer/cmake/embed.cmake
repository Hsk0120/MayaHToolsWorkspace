# 実行時の展開を不要にする、UTF-8 Pythonソースのバイト配列。
file(GLOB files RELATIVE "${SOURCE_DIR}" "${SOURCE_DIR}/*.py")
list(SORT files)
set(header "// 自動生成。編集元はpython/。\n#pragma once\n")
set(entries "")
set(index 0)
foreach(file IN LISTS files)
    get_filename_component(module "${file}" NAME_WE)
    file(READ "${SOURCE_DIR}/${file}" content HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${content}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" bytes "${bytes}")
    string(APPEND header "const unsigned char source${index}[] = {${bytes}0};\n")
    string(APPEND entries "{\"${module}\", reinterpret_cast<const char*>(source${index})},\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND header "struct EmbeddedSource { const char* name; const char* text; };\nconst EmbeddedSource sources[] = {${entries}};\n")
file(WRITE "${OUTPUT}" "${header}")
