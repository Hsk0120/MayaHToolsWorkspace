msgstr ":py:obj:`_joint_rotation_transfer_values <hlib.nodes.joint.Joint._joint_rotation_transfer_values>`\\ \\(\\[to\\_orient\\]\\)"

msgid "書込み可否を検証し、合成後の回転を現在の角度単位で返す。"
msgstr "Verify write permission and return the final rotation in the current angle unit."

msgid ":py:obj:`_remove_segment_scale_compensation <hlib.nodes.joint.Joint._remove_segment_scale_compensation>`\\ \\(matrix\\)"
msgstr ":py:obj:`_remove_segment_scale_compensation <hlib.nodes.joint.Joint._remove_segment_scale_compensation>`\\ \\(matrix\\)"

