msgstr "Returns the original value from the matrix after ssc and inverseScale have been applied."

msgid ":py:obj:`_rotate_reference <hlib.nodes.joint.Joint._rotate_reference>`\\ \\(reference\\)"
msgstr ":py:obj:`_rotate_reference <hlib.nodes.joint.Joint._rotate_reference>`\\ \\(reference\\)"

msgid ":meth:`getRotation` が Euler の解を選ぶ基準を返す。"
msgstr ":meth:`getRotation` returns the criterion for selecting Euler solutions."

msgid ":py:obj:`_rotation_order <hlib.nodes.joint.Joint._rotation_order>`\\ \\(\\)"
msgstr ":py:obj:`_rotation_order <hlib.nodes.joint.Joint._rotation_order>`\\ \\(\\)"

msgid "Maya の rotateOrder を API の回転順序へ変換する。"
msgstr "Convert Maya's rotateOrder to API rotation order."

msgid ":py:obj:`_rotation_quaternion <hlib.nodes.joint.Joint._rotation_quaternion>`\\ \\(attribute\\)"
msgstr ":py:obj:`_rotation_quaternion <hlib.nodes.joint.Joint._rotation_quaternion>`\\ \\(attribute\\)"

