msgstr ":py:obj:`_contains_plug <hlib.scene.drivenKey._contains_plug>`\\ \\(plugs\\, mplug\\)"

msgid "同じプラグ(所有ノード・アトリビュート・配列インデックスが一致)が含まれるか判定する。"
msgstr "Check if the same plug (with matching owner node, attribute, and array index) is contained."

msgid ":py:obj:`_curves <hlib.scene.drivenKey._curves>`\\ \\(driven\\[\\, strict\\]\\)"
msgstr ":py:obj:`_curves <hlib.scene.drivenKey._curves>`\\ \\(driven\\[\\, strict\\]\\)"

