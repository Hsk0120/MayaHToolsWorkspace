msgstr "``str | Module | None``"

msgid "版の取得元にする Maya モジュール名(``\"Bifrost\"`` など)。省略すると ``version_plugin`` の版を使う。"
msgstr "Maya module name to use as the source of the version (such as ``\"Bifrost\"``). If omitted, uses the version of ``version_plugin``."

msgid "``version_plugin``"
msgstr "``version_plugin``"

