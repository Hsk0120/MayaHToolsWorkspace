msgstr "Records to output."

msgid "hlib.utils.logger"
msgstr "hlib.utils.logger"

msgid "標準 logging と Maya のメッセージ表示を連携する。"
msgstr "Integrate standard logging with Maya's message display."

msgid ":py:obj:`MayaHandler <hlib.utils.logger.MayaHandler>`\\"
msgstr ":py:obj:`MayaHandler <hlib.utils.logger.MayaHandler>`\\"

msgid ":py:obj:`debug <hlib.utils.logger.debug>`\\ \\(message\\, \\*args\\, \\*\\*kwargs\\)"
msgstr ":py:obj:`debug <hlib.utils.logger.debug>`\\ \\(message\\, \\*args\\, \\*\\*kwargs\\)"

