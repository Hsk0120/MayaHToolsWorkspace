msgstr "``str | Plugin | None``"

msgid "版を調べるプラグイン。省略すると ``plugins`` の先頭。"
msgstr "Plugin to check the version. If omitted, it refers to the beginning of ``plugins``."

msgid "``minimum_maya``"
msgstr "``minimum_maya``"

msgid "``int | None``"
