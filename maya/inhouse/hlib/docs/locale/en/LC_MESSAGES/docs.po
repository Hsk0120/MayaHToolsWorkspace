msgstr "Load and set weights from a JSON file output by dumpWeights()."

msgid ":py:obj:`normalizeWeights <hlib.nodes.skinCluster.SkinCluster.normalizeWeights>`\\ \\(\\[decimals\\, fast\\]\\)"
msgstr ":py:obj:`normalizeWeights <hlib.nodes.skinCluster.SkinCluster.normalizeWeights>`\\ \\(\\[decimals\\, fast\\]\\)"

