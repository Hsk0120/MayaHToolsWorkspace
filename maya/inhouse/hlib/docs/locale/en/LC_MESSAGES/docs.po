msgstr "Plug-ins to load. Load them in this order."

msgid "``minimum_version``"
msgstr "``minimum_version``"

msgid "``str | int | tuple[int, ...] | None``"
msgstr "``str | int | tuple[int, ...] | None``"

msgid "必要な最小の版(``\"3.0.0\"`` など)。省略すると版は問わず、導入されていればよい。"
msgstr "Required minimum version (``\"3.0.0\"``, etc.). If omitted, any version is acceptable as long as it is installed."

msgid "``module``"
msgstr "``module``"

