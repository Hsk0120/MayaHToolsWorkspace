msgid ":py:obj:`__reduce_ex__ <hlib.maths.eulerRotation.EulerRotation.__reduce_ex__>`\\ \\(protocol\\)"
msgstr ":py:obj:`__reduce_ex__ <hlib.maths.eulerRotation.EulerRotation.__reduce_ex__>`\\ \\(protocol\\)"

msgid "pickle のプロトコルにかかわらず __reduce__ と同じ情報を返す。"
msgstr "Returns the same information as ``__reduce__``, regardless of the pickle protocol."

msgid ":py:obj:`__repr__ <hlib.maths.eulerRotation.EulerRotation.__repr__>`\\ \\(\\)"
msgstr ":py:obj:`__repr__ <hlib.maths.eulerRotation.EulerRotation.__repr__>`\\ \\(\\)"

