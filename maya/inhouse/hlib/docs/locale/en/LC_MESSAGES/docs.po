msgstr "Convert from local matrix rotation to the rotate attribute values, excluding jointOrient and rotateAxis."

msgid ":py:obj:`_compound_values <hlib.nodes.joint.Joint._compound_values>`\\ \\(attribute\\[\\, angle\\]\\)"
msgstr ":py:obj:`_compound_values <hlib.nodes.joint.Joint._compound_values>`\\ \\(attribute\\[\\, angle\\]\\)"

