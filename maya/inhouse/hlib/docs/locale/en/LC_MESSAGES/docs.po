msgstr "Normalize the vertex weights of the first mesh so that they sum to 1."

msgid ":py:obj:`redistributeWeights <hlib.nodes.skinCluster.SkinCluster.redistributeWeights>`\\ \\(vertices\\[\\, method\\]\\)"
msgstr ":py:obj:`redistributeWeights <hlib.nodes.skinCluster.SkinCluster.redistributeWeights>`\\ \\(vertices\\[\\, method\\]\\)"

msgid "頂点ごとのウェイト配分を、イージング曲線で強弱をつけて配り直す。"
msgstr "Redistribute vertex weights with easing curves to vary the strength."

msgid ":py:obj:`removeInfluence <hlib.nodes.skinCluster.SkinCluster.removeInfluence>`\\ \\(joint\\[\\, transfer\\_to\\_parent\\]\\)"
msgstr ":py:obj:`removeInfluence <hlib.nodes.skinCluster.SkinCluster.removeInfluence>`\\ \\(joint\\[\\, transfer\\_to\\_parent\\]\\)"

