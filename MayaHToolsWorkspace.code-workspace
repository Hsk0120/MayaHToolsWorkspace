{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "maya.pythonExecutable": "C:/Program Files/Autodesk/Maya2027/bin/mayapy.exe",
    "python.defaultInterpreterPath": "C:/Program Files/Autodesk/Maya2027/bin/mayapy.exe",
    "task.saveBeforeRun": "always",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[bat]": {
      "files.autoGuessEncoding": true
    },
    "C_Cpp.default.includePath": [
      "C:/Program Files/Autodesk/Maya2026/include"
    ],
    "C_Cpp.default.defines": [
      "NT_PLUGIN",
      "REQUIRE_IOSTREAM",
      "_BOOL"
    ],
    "C_Cpp.default.cppStandard": "c++17"
  },
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "ms-python.vscode-pylance"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Maya: Run current Python file",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/tools/send_to_maya.py",
          "${file}"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Maya plugin: Build MayaCinematicCameraHUD",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/tools/build_maya_plugin.py",
          "${workspaceFolder}/maya/inhouse/MayaCinematicCameraHUD",
          "--versions",
          "${input:mayaVersion}"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "mlib: Format with ruff",
        "type": "process",
        "command": "${workspaceFolder}/maya/inhouse/mlib/_tools/format_mlib.bat",
        "args": [
          "--no-pause"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "mlib: Update type stubs",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/maya/inhouse/mlib/_tools/generate_mlib_stubs.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ],
    "inputs": [
      {
        "id": "mayaVersion",
        "type": "pickString",
        "description": "ビルドするMayaバージョン",
        "options": ["2026", "2024", "2022", "2025", "2027"],
        "default": "2026"
      }
    ]
  }
}
