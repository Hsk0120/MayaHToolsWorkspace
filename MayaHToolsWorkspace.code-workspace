{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "maya.pythonExecutable": "C:/Program Files/Autodesk/Maya2027/bin/mayapy.exe",
    "python.defaultInterpreterPath": "C:/Program Files/Autodesk/Maya2027/bin/mayapy.exe",
    "task.saveBeforeRun": "always",
    "[python]": {
      "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "[bat]": {
      "files.autoGuessEncoding": true
    },
    "C_Cpp.default.includePath": [
      "C:/Program Files/Autodesk/Maya2026/include"
    ],
    "C_Cpp.default.defines": [
      "NT_PLUGIN",
      "REQUIRE_IOSTREAM",
      "_BOOL"
    ],
    "C_Cpp.default.cppStandard": "c++17",
    // 外部ツール(maya/external、9GB超・約30万ファイル)や生成物は、C/C++の索引・ファイル監視・検索の対象にしない。
    // 索引がワークスペース全体のC++ソースを読むと、起動のたびにディスクとCPUを長く使うため。
    "C_Cpp.files.exclude": {
      "**/.git": true,
      "**/.vscode": true,
      "maya/external/**": true,
      "maya/site-packages/**": true,
      ".maya-output/**": true,
      "typings/**": true
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/modules/**": true,
      "maya/external/**": true,
      "maya/site-packages/**": true,
      ".maya-output/**": true,
      "typings/**": true,
      "**/_tools/.venv/**": true,
      "**/_tools/.mayapy-site/**": true,
      "**/_docs/_build/**": true,
      "**/__tests__/_output/**": true,
      "**/__pycache__/**": true,
      "**/.ruff_cache/**": true
    },
    "search.exclude": {
      "maya/external": true,
      "maya/site-packages": true,
      ".maya-output": true,
      "typings": true,
      "**/_tools/.venv": true,
      "**/_tools/.mayapy-site": true,
      "**/_docs/_build": true,
      "**/__tests__/_output": true,
      "**/.ruff_cache": true
    },
    // 起動時にCMakeの構成を走らせない(プラグインのビルドは tools/build_maya_plugin.py かタスクで行う)。
    "cmake.configureOnOpen": false,
    // submodule が150個以上あるため、submodule の中身の変更確認と自動fetchを省く(git status が約3.6秒→0.3秒)。
    // submodule の中を編集したときは、そのsubmoduleのフォルダーで確かめる。
    "git.ignoreSubmodules": true,
    "git.detectSubmodules": false,
    "git.autofetch": false
  },
  "extensions": {
    "recommendations": [
      "charliermarsh.ruff",
      "ms-python.vscode-pylance"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Maya: Run current Python file",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/tools/send_to_maya.py",
          "${file}"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "Maya plugin: Build MayaCinematicCameraHUD",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/tools/build_maya_plugin.py",
          "${workspaceFolder}/maya/inhouse/MayaCinematicCameraHUD",
          "--versions",
          "${input:mayaVersion}"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "group": "build",
        "problemMatcher": "$msCompile",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "mlib: Format with ruff",
        "type": "process",
        "command": "${workspaceFolder}/maya/inhouse/mlib/_tools/format_mlib.bat",
        "args": [
          "--no-pause"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      },
      {
        "label": "mlib: Update type stubs",
        "type": "process",
        "command": "${config:maya.pythonExecutable}",
        "args": [
          "${workspaceFolder}/maya/inhouse/mlib/_tools/generate_mlib_stubs.py"
        ],
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "panel": "dedicated"
        }
      }
    ],
    "inputs": [
      {
        "id": "mayaVersion",
        "type": "pickString",
        "description": "ビルドするMayaバージョン",
        "options": ["2026", "2024", "2022", "2025", "2027"],
        "default": "2026"
      }
    ]
  }
}
